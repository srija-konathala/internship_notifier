# Copy this file to `.env` and fill in values. Never commit `.env`.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: NASA via USAJOBS (https://developer.usajobs.gov/)
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=your.email@example.com

# Optional: UK aggregators. Without these the Adzuna and Reed sources skip
# themselves and everything else still runs.
# Free credentials: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Free key: https://www.reed.co.uk/developers
REED_API_KEY=
